datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid()) @map("_id")
  username  String
  email     String    @unique
  password  String
  expenses  Expense[]
  createdAt DateTime  @default(now())
}

model Expense {
  id          String   @id @default(uuid()) @map("_id")
  title       String
  amount      Float
  category    String
  date        DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}
